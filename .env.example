# OmniDoc RAG environment configuration
# Copy this file to .env and fill in your keys.

# ── Qdrant ────────────────────────────────────────────────────────────────────
OMNIDOC_QDRANT_HOST=localhost
OMNIDOC_QDRANT_PORT=6333
OMNIDOC_QDRANT_COLLECTION=omnidoc_vectors
OMNIDOC_QDRANT_VECTOR_SIZE=1024

# ── Embedding (choose "bge" for local or "openai" for cloud) ──────────────────
OMNIDOC_EMBEDDING_BACKEND=bge
# OMNIDOC_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── Retrieval ─────────────────────────────────────────────────────────────────
OMNIDOC_RETRIEVAL_TOP_K=100
OMNIDOC_RERANKER_BACKEND=cohere
OMNIDOC_RERANKER_TOP_N=5

# ── Generation (choose "claude" or "gpt4o") ───────────────────────────────────
OMNIDOC_LLM_BACKEND=claude
OMNIDOC_LLM_TEMPERATURE=0.0
OMNIDOC_LLM_MAX_TOKENS=2048

# ── API server ────────────────────────────────────────────────────────────────
OMNIDOC_API_HOST=0.0.0.0
OMNIDOC_API_PORT=8000
OMNIDOC_LOG_LEVEL=INFO

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...
